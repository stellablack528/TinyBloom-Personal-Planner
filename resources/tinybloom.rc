#include <windows.h>
#include "DesktopVersion.h"

IDI_ICON1 ICON "icons/app-icon.ico"
FOCUSSOUND_WIND WAVE "sounds/focus-wind.wav"
FOCUSSOUND_GLASS WAVE "sounds/focus-glass.wav"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TINYBLOOM_DESKTOP_FILE_VERSION
 PRODUCTVERSION TINYBLOOM_DESKTOP_FILE_VERSION
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TinyBloom Contributors\0"
            VALUE "FileDescription", "TinyBloom Desktop Personal Planner\0"
            VALUE "FileVersion", TINYBLOOM_DESKTOP_VERSION
            VALUE "InternalName", "TinyBloom\0"
            VALUE "OriginalFilename", "TinyBloom.exe\0"
            VALUE "ProductName", "TinyBloom Desktop\0"
            VALUE "ProductVersion", TINYBLOOM_DESKTOP_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
